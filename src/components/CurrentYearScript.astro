---
// The footer copyright year is filled in at runtime, so the built HTML never contains a fixed year.
// It runs on the first load and again after every client-side navigation (ClientRouter).
---
<script is:inline>
  (function () {
    function fill() {
      var year = String(new Date().getFullYear());
      var marks = document.querySelectorAll('[data-current-year]');
      for (var i = 0; i < marks.length; i++) marks[i].textContent = year;
    }
    fill();
    if (!window.__currentYearBound) {
      window.__currentYearBound = true;
      document.addEventListener('astro:page-load', fill);
    }
  })();
</script>
