---
// Legal pages show the current date. It is filled in by this inline script at runtime, so the built HTML
// never contains a fixed effective date. The page views are server-rendered only, so no hydration is needed.
---
<script is:inline>
  (function () {
    var now = new Date();
    var iso = now.getFullYear() + '-' + String(now.getMonth() + 1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0');
    var text = now.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
    var marks = document.querySelectorAll('time[data-legal-effective-date]');
    for (var i = 0; i < marks.length; i++) {
      marks[i].setAttribute('datetime', iso);
      marks[i].textContent = text;
    }
  })();
</script>
