---
import HeaderControls from './HeaderControls';
import { siteConfig, publicNavigation, brandConfig } from '@/website-config';

const currentPath = Astro.url.pathname;

---
<header class="fixed inset-x-0 top-0 z-50 bg-background/90 backdrop-blur supports-[backdrop-filter]:bg-background/80">
  <div class="mx-auto flex h-14 max-w-7xl items-center px-5">
    <a href="/" title={`Return to the ${siteConfig.name} homepage`} class="mr-6 flex flex-shrink-0 items-center gap-2">
      <img src={brandConfig.logoRaster.src} width="28" height="28" alt="" class="rounded-[6px]" />
      <span class="font-poppins text-[15px] font-medium tracking-[-0.15px] text-foreground">
        {siteConfig.name}
      </span>
    </a>

    <nav class="hidden flex-1 items-center gap-6 lg:flex" aria-label="Primary navigation">
      {publicNavigation.map((link) => (
        <a
          href={link.href}
          title={link.title}
          aria-current={currentPath === link.activePath ? 'page' : undefined}
          class:list={[
            'text-sm font-medium tracking-[-0.14px] text-muted-foreground transition-colors hover:text-foreground focus-visible:text-foreground focus-visible:outline-none',
            currentPath === link.activePath && 'text-foreground',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex-1 lg:hidden"></div>
    <HeaderControls client:load transition:persist="account-controls" />
  </div>
</header>
