---
export const prerender = false;
import BaseLayout from '@/src/layouts/BaseLayout.astro';
import StaticRender from '@/src/components/StaticRender';
import BlogIndexView, { metadata } from '@/src/components/page-views/blog/BlogIndexView';
const content = await BlogIndexView();
---
<BaseLayout metadata={metadata} path="/blog">
  <StaticRender value={content} />
</BaseLayout>
