  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/postcss": "^4",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "critters": "^0.0.23",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
