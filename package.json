{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/content-metadata.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/content-metadata.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "start": "astro dev",
    "check": "astro check && tsc --noEmit && npm run verify:standards",
    "sync:content-metadata": "node scripts/content-metadata.mjs",
    "verify:content-metadata": "node scripts/verify-content-metadata.mjs",
    "verify:standards": "node scripts/verify-standards.mjs && npm run verify:content-metadata",
    "verify:islands": "node scripts/verify-islands-architecture.mjs",
    "verify:routes": "node scripts/verify-astro-routes.mjs && npm run verify:chunks",
    "verify:chunks": "node scripts/verify-client-chunks.mjs",
    "test:adapters": "node --test scripts/test-template-adapters.mjs",
    "icon": "python scripts/generate-icons.py"
  },
  "dependencies": {
    "@astrojs/react": "6.0.6",
    "@astrojs/vercel": "11.0.10",
